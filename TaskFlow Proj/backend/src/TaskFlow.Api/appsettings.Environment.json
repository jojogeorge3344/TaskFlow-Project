{
  // ===== SINGLE PLACE for per-environment backend settings =====
  // Local is active by default. To deploy: comment the Local lines, uncomment the target environment's lines.
  // Keep exactly ONE value active per key. (Secrets such as Jwt:Key still belong in environment variables.)
  // To override without editing: set env vars, e.g. Cors__AllowedOrigins__0 / Mail__AppBaseUrl.

  "Cors": {
    // Frontend URL(s) allowed to call this API (no trailing slash).
    // Local
     "AllowedOrigins": [ "http://localhost:4200" ]
    // Develop
    //"AllowedOrigins": [ "https://taskflow-project-2.onrender.com" ]
    // QA
    // "AllowedOrigins": [ "https://taskflow-qa.example.com" ]
    // Production
    // "AllowedOrigins": [ "https://taskflow-project.example.com" ]
  },

  "Mail": {
    // Frontend URL used in links inside reminder emails.
    // Local
     "AppBaseUrl": "http://localhost:4200"
    // Develop
    //"AppBaseUrl": "https://taskflow-project-2.onrender.com"
    // QA
    // "AppBaseUrl": "https://taskflow-qa.example.com"
    // Production
    // "AppBaseUrl": "https://taskflow-project.example.com"
  },

  "Seed": {
    // Demo data: true locally, false on QA/Production.
    // Local
    "Enabled": true
    // Develop / QA / Production
    // "Enabled": false
  }
}
