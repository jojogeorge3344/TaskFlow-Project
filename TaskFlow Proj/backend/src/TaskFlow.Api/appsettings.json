{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=../database/taskflow.db"
  },
  "Jwt": {
    "Issuer": "TaskFlow",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Seed": {
    "Enabled": false
  },
  "Application": {
    "Timezone": "Asia/Kolkata"
  },
  "Reminders": {
    "SchedulerEnabled": true,
    "TickSeconds": 60
  },
  "AllowedHosts": "*"
}
