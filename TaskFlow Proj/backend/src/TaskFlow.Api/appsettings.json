{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=taskflow.db"
  },
  "Storage": {
    "Root": ""
  },
  "Jwt": {
    "Issuer": "TaskFlow",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Application": {
    "Timezone": "Asia/Kolkata"
  },
  "Reminders": {
    "SchedulerEnabled": true,
    "TickSeconds": 60
  },
  "Mail": {
    "AttachmentsPath": "mail-attachments"
  },
  "Proxy": {
    "KnownProxies": []
  },
  "Mfa": {
    "Issuer": "TaskFlow",
    "Required": true
  },
  "AiProviders": {
    "KeyRingPath": "dp-keys",
    "TimeoutSeconds": 60,
    "OllamaTimeoutSeconds": 180,
    "OllamaContextTokens": 8192
  },
  "DocumentKnowledge": {
    "Enabled": true,
    "SourcePath": "../../../../TF - Documents",
    "EmbeddingModel": "nomic-embed-text",
    "OllamaBaseUrl": "",
    "TopK": 4,
    "MinScore": 0.6,
    "MaxChunkCharacters": 1500,
    "MaxContextCharacters": 4000,
    "RescanMinutes": 5
  },
  "AllowedHosts": "*"
}
