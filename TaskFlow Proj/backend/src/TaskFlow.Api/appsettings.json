{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=taskflow.db"
  },
  "Storage": {
    "Root": ""
  },
  "Jwt": {
    "Issuer": "TaskFlow",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Application": {
    "Timezone": "Asia/Kolkata"
  },
  "Reminders": {
    "SchedulerEnabled": true,
    "TickSeconds": 60
  },
  "Mail": {
    "AttachmentsPath": "mail-attachments"
  },
  "Proxy": {
    "KnownProxies": []
  },
  "Mfa": {
    "Issuer": "TaskFlow",
    "Required": true
  },
  "AiProviders": {
    "KeyRingPath": "dp-keys",
    "TimeoutSeconds": 60
  },
  "AllowedHosts": "*"
}
