{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=taskflow.db"
  },
  "Storage": {
    "Root": "C:\\TaskFlow"
  },
  "Jwt": {
    "Issuer": "TaskFlow",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Seed": {
    "Enabled": true
  },
  "Application": {
    "Timezone": "Asia/Kolkata"
  },
  "Reminders": {
    "SchedulerEnabled": true,
    "TickSeconds": 60
  },
  "Mail": {
    "AttachmentsPath": "mail-attachments",
    "AppBaseUrl": "http://localhost:4200"
  },
  "AiProviders": {
    "KeyRingPath": "dp-keys",
    "TimeoutSeconds": 60
  },
  "AllowedHosts": "*"
}
